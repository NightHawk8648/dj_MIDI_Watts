{
  "name": "dj-midi-watts-desktop",
  "version": "1.0.0",
  "description": "Desktop server and UI launcher for DJ MIDI WATTS",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "agent:setup": "python ../agents/agent_manager.py",
    "agent:assemble": "powershell -File ../agents/build_agents.ps1 assemble",
    "agent:debug": "powershell -File ../agents/build_agents.ps1 debug",
    "agent:build": "powershell -File ../agents/build_agents.ps1 build"
  },
  "dependencies": {
    "open": "^8.4.2"
  }
}
