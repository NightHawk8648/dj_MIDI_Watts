# Gradle Environment Example
# Copy this file to .env and replace placeholder values with your actual secrets.
# This file is synchronized with .env.example for consistency.

# ============================================================================
# GEMINI & GOOGLE CLOUD
# ============================================================================

GRADLE_GEMINI_API_KEY=YOUR_GEMINI_API_KEY
UG_S1=${GRADLE_GEMINI_API_KEY}

GRADLE_GOOGLE_OAUTH_CLIENT_ID=YOUR_OAUTH_CLIENT_ID.apps.googleusercontent.com
UG_S2=${GRADLE_GOOGLE_OAUTH_CLIENT_ID}

GCP_PROJECT_ID=dj-midi-watts
GOOGLE_APPLICATION_CREDENTIALS=secrets/google-play-service.json

# ============================================================================
# APK SIGNING & KEYSTORE
# ============================================================================

GRADLE_KEYSTORE_PATH=path/to/your/keystore.jks
GRADLE_KEYSTORE_PASSWORD=YOUR_KEYSTORE_PASSWORD
GRADLE_KEY_ALIAS=your_key_alias
GRADLE_KEY_PASSWORD=YOUR_KEY_PASSWORD
KEYSTORE_PATH=${GRADLE_KEYSTORE_PATH}
STORE_PASSWORD=${GRADLE_KEYSTORE_PASSWORD}
KEY_ALIAS=${GRADLE_KEY_ALIAS}
KEY_PASSWORD=${GRADLE_KEY_PASSWORD}

# ============================================================================
# MTLS CERTIFICATES
# ============================================================================

GRADLE_CERT_PATH=certs/client.crt
GRADLE_CERT_KEY=certs/client.key
GRADLE_CA_BUNDLE=certs/ca.crt
UG_CERT_PATH=${GRADLE_CERT_PATH}
UG_CERT_KEY=${GRADLE_CERT_KEY}
UG_CA_BUNDLE=${GRADLE_CA_BUNDLE}
CLIENT_CERT_PATH=${GRADLE_CERT_PATH}
CLIENT_KEY_PATH=${GRADLE_CERT_KEY}
CA_BUNDLE_PATH=${GRADLE_CA_BUNDLE}

# ============================================================================
# KOTLIN & ANDROID COMPILER
# ============================================================================

KOTLIN_JVM_TARGET=17
KOTLIN_INCREMENTAL=true
ANDROID_HOME=/path/to/android/sdk
ANDROID_SDK_ROOT=${ANDROID_HOME}
ANDROID_NDK_HOME=/path/to/android/ndk

# ============================================================================
# BUILD CONFIGURATION
# ============================================================================

WEB_PORT=8080
DEBUG_MODE=true
