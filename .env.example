# ============================================================================
# GEMINI AI & GOOGLE CLOUD
# ============================================================================

# S1: Gemini AI Orchestration Key (Used by Android Host, engine.py, web-ui)
UG_S1="YOUR_GENERATIVE_AI_CLIENT_ID"
UG_S1_"YOUR_GENERATIVE_AI_KEY"
UG_S1_RELEASE="RELEASE_KEY_HERE"
GRADLE_GENERATIVE_AI_API_KEY=${UG_S1}

# S2: OAuth Client ID (Used for WIF and Login - web-ui, Android, extension)
UG_S2="YOUR_GRADLE_OAUTH_CLIENT_ID"
GRADLE_OAUTH_CLIENT_ID=${UG_S2}

# Google Cloud Project Configuration
GCP_PROJECT_ID="your-gcp-project-id"
GCP_REGION=""
GOOGLE_APPLICATION_CREDENTIALS=""

# ============================================================================
# HUGGINGFACE & ML MODELS
# ============================================================================

HUGGINGFACE_API_KEY="hf_YOUR_HUGGINGFACE_API_TOKEN_HERE"
HUGGINGFACE_MODEL_ID=""

# ============================================================================
# MEDIA PLAYER API KEYS
# ============================================================================

SPOTIFY_CLIENT_ID="YOUR_SPOTIFY_CLIENT_ID"
SPOTIFY_CLIENT_SECRET="YOUR_SPOTIFY_CLIENT_SECRET"
YOUTUBE_API_KEY="YOUR_YOUTUBE_API_KEY"
SOUNDCLOUD_API_KEY="YOUR_SOUNDCLOUD_API_KEY"

# ============================================================================
# BROWSER EXTENSION KEYS (Chrome, Edge, Firefox)
# ============================================================================

# Chrome Web Store Developer Account
CHROME_EXTENSION_ID="YOUR_CHROME_EXTENSION_ID"
CHROME_DEVELOPER_TOKEN="YOUR_CHROME_DEVELOPER_TOKEN"

# Edge Add-ons Store
EDGE_EXTENSION_ID="YOUR_EDGE_EXTENSION_ID"
EDGE_DEVELOPER_TOKEN="YOUR_EDGE_DEVELOPER_TOKEN"

# Firefox Add-ons
FIREFOX_EXTENSION_ID="YOUR_FIREFOX_EXTENSION_ID"
FIREFOX_DEVELOPER_TOKEN="YOUR_FIREFOX_DEVELOPER_TOKEN"

# ============================================================================
# REACT & WEB-UI CONFIGURATION
# ============================================================================

REACT_APP_API_URL="http://localhost:8080"
REACT_APP_WS_URL="ws://localhost:8080"
REACT_APP_ENVIRONMENT="development"
REACT_APP_LOG_LEVEL="debug"

# ============================================================================
# ANDROID STUDIO & KOTLIN
# ============================================================================

# S3: mTLS / Certificate Settings (For Wireless Injection)
UG_CERT_PATH=certs/client.crt
UG_CERT_KEY=certs/client.key
UG_CA_BUNDLE=certs/ca.crt
UG_S3_KEYSTORE_PASS=android

# Keystore configuration for signing APKs
GRADLE_KEYSTORE_PATH=path/to/your/keystore.jks
GRADLE_KEYSTORE_PASSWORD=YOUR_KEYSTORE_PASSWORD
GRADLE_KEY_ALIAS=your_key_alias
GRADLE_KEY_PASSWORD=YOUR_KEY_PASSWORD
KEYSTORE_PATH=${GRADLE_KEYSTORE_PATH}
STORE_PASSWORD=${GRADLE_KEYSTORE_PASSWORD}
KEY_ALIAS=${GRADLE_KEY_ALIAS}
KEY_PASSWORD=${GRADLE_KEY_PASSWORD}

# Optional: MTLS certificate settings
GRADLE_CERT_PATH=${UG_CERT_PATH}
GRADLE_CERT_KEY=${UG_CERT_KEY}
GRADLE_CA_BUNDLE=${UG_CA_BUNDLE}
CLIENT_CERT_PATH=${UG_CERT_PATH}
CLIENT_KEY_PATH=${UG_CERT_KEY}
CA_BUNDLE_PATH=${UG_CA_BUNDLE}

# Kotlin Compiler Configuration
KOTLIN_JVM_TARGET="17"
KOTLIN_INCREMENTAL=true

# Android NDK (for C++ support if needed)
ANDROID_NDK_HOME="path/to/android-ndk"

# ============================================================================
# ENGINE.PY BACKEND CONFIGURATION
# ============================================================================

PYTHON_ENV="development"
WEB_PORT=8080
DEBUG_MODE=true
LOG_LEVEL="DEBUG"
