# DJ MIDI WATTS - User Personal API and Credentials Configuration
# Copy this file to `user.env` and replace placeholder values with your actual secrets.
# IMPORTANT: Never commit `user.env` to source control. It is already added to `.gitignore`.
# For maximum security, use scripts/provision_credentials.ps1 to cache these in your OS secure vault.

# ============================================================================
# GEMINI AI & GOOGLE CLOUD
# ============================================================================
# Gemini AI Orchestration Key
UG_S1="YOUR_PERSONAL_GEMINI_API_KEY"

# Google OAuth Client ID
UG_S2="YOUR_PERSONAL_GOOGLE_OAUTH_CLIENT_ID"

# Google Cloud Project Configuration
GCP_PROJECT_ID="your-gcp-project-id"
GCP_BILLING_ACCOUNT="your-gcp-billing-account"
GCP_SERVICE_ACCOUNT_EMAIL="your-service-account-email"
GCP_SERVICE_ACCOUNT_KEY_PATH="secrets/google-play-service.json"

# ============================================================================
# MTLS CERTIFICATES (For Wireless Injection)
# ============================================================================
UG_CERT_PATH="certs/client.crt"
UG_CERT_KEY="certs/client.key"
UG_CA_BUNDLE="certs/ca.crt"
UG_S3_KEYSTORE_PASS="android"

# ============================================================================
# THIRD-PARTY INTEGRATIONS
# ============================================================================
# Spotify API credentials
SPOTIFY_CLIENT_ID="YOUR_SPOTIFY_CLIENT_ID"
SPOTIFY_CLIENT_SECRET="YOUR_SPOTIFY_CLIENT_SECRET"

# Chrome Web Store Developer Account
CHROME_CLIENT_ID="YOUR_CHROME_CLIENT_ID"
CHROME_CLIENT_SECRET="YOUR_CHROME_CLIENT_SECRET"

# Code signing certificate and password for Windows installer
CODE_SIGN_CERT="certs/code-sign.pfx"
CODE_SIGN_PASS="YOUR_CODE_SIGN_PASSWORD"
